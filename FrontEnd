        letterSpacing = 1.sp
    )
}

// ==========================================
// REUSABLE STATUS BADGE
// ==========================================

@Composable
fun StatusBadge(text: String) {

    val isNext = text == "NEXT"
    val isOngoing = text == "ONGOING"

    Box(
        modifier = Modifier
            .background(
                when {
                    isNext || isOngoing -> LightAmber
                    else -> LightTeal
                },
                RoundedCornerShape(8.dp)
            )
            .padding(
                horizontal = 10.dp,
                vertical = 6.dp
            )
    ) {
        Text(
            text,
            color = if (isNext || isOngoing) Navy else Teal,
            fontSize = 10.sp,
            fontWeight = FontWeight.Bold
        )
    }
}

// ==========================================
// REUSABLE MESSAGE CARD
// ==========================================

@Composable
fun MessageCard(message: String, successful: Boolean) {

    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(14.dp),
        colors = CardDefaults.cardColors(
            containerColor = if (successful) LightTeal else LightAmber
        )
    ) {
        Text(
            message,
            modifier = Modifier.padding(15.dp),
            color = Navy,
            fontSize = 13.sp,
            fontWeight = FontWeight.Medium,
            lineHeight = 20.sp
        )
    }
}
